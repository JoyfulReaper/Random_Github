@page
@model IndexModel
@{
    ViewData["Title"] = "Random GitHub";
}

<section class="hero">
    <div>
        <h1>Random GitHub</h1>
        <p>Discover some random corner of GitHub you probably had no reason to ever find.</p>
    </div>

    <form method="post" class="d-flex align-items-center gap-3 flex-wrap">
        <button type="submit" class="btn btn-primary btn-lg">
            Random Repository
        </button>

        <div class="form-check">
            <input class="form-check-input" asp-for="ExcludeForks" />
            <label class="form-check-label" asp-for="ExcludeForks">
                Skip forks
            </label>
        </div>
    </form>
</section>

@if (Model.Repository is not null)
{
    <article class="repository-card">
        <header class="repository-header">
            <img class="owner-avatar"
                 src="@Model.Repository.Owner.AvatarUrl"
                 alt="@Model.Repository.Owner.Login" />

            <div>
                <h2>
                    <a href="@Model.Repository.HtmlUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @Model.Repository.FullName
                    </a>
                </h2>

                <a class="owner-link"
                   href="@Model.Repository.Owner.HtmlUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    @Model.Repository.Owner.Login
                </a>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.Repository.Description))
        {
            <p class="repository-description">
                @Model.Repository.Description
            </p>
        }

        <div class="repository-meta">
            <span>
                <strong>Language</strong>
                @(Model.Repository.Language ?? "Unknown")
            </span>

            <span>
                <strong>Stars</strong>
                @Model.Repository.StargazersCount
            </span>

            <span>
                <strong>Forks</strong>
                @Model.Repository.ForksCount
            </span>

            <span>
                <strong>ID</strong>
                @Model.Repository.Id
            </span>

            @if (Model.Repository.CreatedAt is { } createdAt)
            {
                <span>
                    <strong>Created</strong>
                    <time datetime="@createdAt.ToString("O")">
                        @createdAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }

            @if (Model.Repository.UpdatedAt is { } updatedAt)
            {
                <span>
                    <strong>Updated</strong>
                    <time datetime="@updatedAt.ToString("O")">
                        @updatedAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }

            @if (Model.Repository.PushedAt is { } pushedAt)
            {
                <span>
                    <strong>Last push</strong>
                    <time datetime="@pushedAt.ToString("O")">
                        @pushedAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }
        </div>
    </article>

    @if (!string.IsNullOrWhiteSpace(Model.ReadmeHtml))
    {
        <section class="readme-card">
            <header>
                <h2>README</h2>
            </header>

            <div class="readme">
                @Html.Raw(Model.ReadmeHtml)
            </div>
        </section>
    }
}