@page
@model IndexModel
@{
    ViewData["Title"] = "Random GitHub";
}

<section class="hero">
    <div>
        <h1>Random GitHub</h1>
        <p>Discover some random corner of GitHub you probably had no reason to ever find.</p>
    </div>

    <form method="post">
        <button type="submit" class="btn btn-primary btn-lg">
            Random Repository
        </button>
    </form>
</section>

@if (Model.Repository is not null)
{
    <article class="repository-card">
        <header class="repository-header">
            <img class="owner-avatar"
                 src="@Model.Repository.Owner.AvatarUrl"
                 alt="@Model.Repository.Owner.Login" />

            <div>
                <h2>
                    <a href="@Model.Repository.HtmlUrl" target="_blank" rel="noopener noreferrer">
                        @Model.Repository.FullName
                    </a>
                </h2>

                <a class="owner-link"
                   href="@Model.Repository.Owner.HtmlUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    @Model.Repository.Owner.Login
                </a>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.Repository.Description))
        {
            <p class="repository-description">
                @Model.Repository.Description
            </p>
        }

        <div class="repository-meta">
            <span>
                <strong>Language</strong>
                @(Model.Repository.Language ?? "Unknown")
            </span>

            <span>
                <strong>Stars</strong>
                @Model.Repository.StargazersCount
            </span>

            <span>
                <strong>Forks</strong>
                @Model.Repository.ForksCount
            </span>

            <span>
                <strong>ID</strong>
                @Model.Repository.Id
            </span>
        </div>
    </article>

    @if (!string.IsNullOrWhiteSpace(Model.ReadmeHtml))
    {
        <section class="readme-card">
            <header>
                <h2>README</h2>
            </header>

            <div class="readme">
                @Html.Raw(Model.ReadmeHtml)
            </div>
        </section>
    }
}