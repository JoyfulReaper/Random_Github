@page
@model IndexModel
@{
    ViewData["Title"] = "Random GitHub";
}

<section class="hero">
    <div>
        <h1>Random GitHub</h1>
        <p>Discover some random corner of GitHub you probably had no reason to ever find.</p>
    </div>

    <form method="get"
          id="random-repository-form"
          class="d-flex align-items-center gap-3 flex-wrap">
        <button type="submit"
                id="random-repository-button"
                class="btn btn-primary btn-lg">
            <span id="random-repository-spinner"
                  class="spinner-border spinner-border-sm me-2 d-none"
                  aria-hidden="true"></span>

            <span id="random-repository-button-text">
                Random Repository
            </span>
        </button>

        <div class="form-check">
            <input class="form-check-input" asp-for="ExcludeForks" />
            <label class="form-check-label" asp-for="ExcludeForks">
                Skip forks
            </label>
        </div>
    </form>
</section>

@if (Model.PersonalTokenInvalid)
{
    <div class="alert alert-danger" role="alert">
        <strong>GitHub rejected that token.</strong>
        The token may be invalid, expired, or revoked. It has been removed
        from your session.
    </div>
}

@if (Model.GitHubRateLimited)
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">GitHub API limit reached</h2>

        @if (Model.UsingPersonalAccessToken)
        {
            <p>
                Your GitHub token has reached its current API limit.
                You can wait for it to reset or forget the token above
                to return to the site's shared allowance.
            </p>
        }
        else
        {
            <p>
                Random GitHub has used up its shared GitHub API allowance.
                You can wait for it to reset or use your own GitHub token above.
            </p>
        }

        <p class="mb-0">
            @if (Model.GitHubRetryAt is { } retryAt)
            {
                <span>
                    GitHub says requests should be available again after
                    <time datetime="@retryAt.ToString("O")">
                        @retryAt.UtcDateTime.ToString("h:mm tt 'UTC'")
                    </time>.
                </span>
            }
            else
            {
                <span>Please try again in a little while.</span>
            }
        </p>
    </div>
}

@if (Model.Repository is not null)
{
    @if (Model.IsSelfPick)
    {
        <div class="alert alert-warning self-pick-alert" role="status">
            <strong>OH SHIT. IT PICKED ITSELF.</strong>

            <div>
                Random GitHub randomly selected Random GitHub.
                No weighting. No cheating. The machine has become self-aware.
            </div>
        </div>
    }

    <article class="repository-card">
        <header class="repository-header">
            <img class="owner-avatar"
                 src="@Model.Repository.Owner.AvatarUrl"
                 alt="@Model.Repository.Owner.Login" />

            <div>
                <h2>
                    <a href="@Model.Repository.HtmlUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @Model.Repository.FullName
                    </a>
                </h2>

                <a class="owner-link"
                   href="@Model.Repository.Owner.HtmlUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    @Model.Repository.Owner.Login
                </a>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.Repository.Description))
        {
            <p class="repository-description">
                @Model.Repository.Description
            </p>
        }

        <div class="repository-meta">
            <span>
                <strong>Language</strong>
                @(Model.Repository.Language ?? "Unknown")
            </span>

            <span>
                <strong>Stars</strong>
                @Model.Repository.StargazersCount
            </span>

            <span>
                <strong>Forks</strong>
                @Model.Repository.ForksCount
            </span>

            <span>
                <strong>ID</strong>
                @Model.Repository.Id
            </span>

            @if (Model.Repository.CreatedAt is { } createdAt)
            {
                <span>
                    <strong>Created</strong>
                    <time datetime="@createdAt.ToString("O")">
                        @createdAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }

            @if (Model.Repository.UpdatedAt is { } updatedAt)
            {
                <span>
                    <strong>Updated</strong>
                    <time datetime="@updatedAt.ToString("O")">
                        @updatedAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }

            @if (Model.Repository.PushedAt is { } pushedAt)
            {
                <span>
                    <strong>Last push</strong>
                    <time datetime="@pushedAt.ToString("O")">
                        @pushedAt.ToString("MMM d, yyyy")
                    </time>
                </span>
            }
        </div>
    </article>

    @if (!string.IsNullOrWhiteSpace(Model.ReadmeHtml))
    {
        <section class="readme-card">
            <header>
                <h2>README</h2>
            </header>

            <div class="readme">
                @Html.Raw(Model.ReadmeHtml)
            </div>
        </section>
    }
}

@if (Model.Stats is not null)
{
    <div class="text-center text-body-secondary small mb-4">
        <span>
            @Model.Stats.TotalHits.ToString("N0") visits
        </span>

        <span class="mx-2">&middot;</span>

        <span>
            @Model.Stats.UniqueVisitors.ToString("N0") unique visitors
        </span>

        <span class="mx-2">&middot;</span>

        <span>
            @Model.Stats.RandomRepositoriesServed.ToString("N0") random repositories served
        </span>
    </div>
}

@if (Model.UsingPersonalAccessToken)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center gap-3"
         role="status">
        <div>
            <strong>Using your GitHub token</strong>
            <div>
                GitHub API requests for this session are using your personal access token.
            </div>
        </div>

        <form method="post" asp-page-handler="ForgetToken">
            <button type="submit" class="btn btn-sm btn-outline-light">
                Forget token
            </button>
        </form>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">
                Use your own GitHub token
            </h2>

            <p class="card-text">
                Optional. A fine-grained GitHub personal access token lets
                Random GitHub use your own API allowance instead of the
                site's shared allowance.
            </p>

            <p class="card-text small text-body-secondary">
                The token only needs <strong>Public repositories</strong>
                access with no additional repository or user permissions.
                It is kept only in the server-side session and is not
                persisted permanently.
            </p>

            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <a class="btn btn-sm btn-outline-secondary"
                   href="https://github.com/JoyfulReaper/Random_Github/blob/main/RandomGithub.Web/Services/GitHubAuthenticationHandler.cs"
                   target="_blank"
                   rel="noopener noreferrer">
                    Inspect token handling source
                </a>

                <span class="small text-body-secondary">
                    Assuming this server is running the published source, of course.
                </span>
            </div>

            <form method="post"
                  asp-page-handler="UseToken"
                  class="d-flex gap-2 flex-wrap">
                <input asp-for="PersonalAccessToken"
                       type="password"
                       class="form-control"
                       placeholder="github_pat_..."
                       autocomplete="off"
                       aria-label="GitHub personal access token" />

                <button type="submit"
                        class="btn btn-outline-primary">
                    Use token
                </button>
            </form>
        </div>
    </div>
}