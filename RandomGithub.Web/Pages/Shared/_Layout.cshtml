@using RandomGithub.GitHub
@inject GitHubRateLimitStatus GitHubRateLimitStatus

@{
    var rateLimit = GitHubRateLimitStatus.Latest;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Random GitHub</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RandomGithub.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand">
            <div class="container-xl">
                <a class="navbar-brand" asp-page="/Index">
                    Random GitHub
                </a>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-page="/Index">
                        Random
                    </a>
                    <a class="nav-link"
                       href="https://www.kgivler.com"
                       target="_blank"
                       rel="noopener noreferrer">
                        Website
                    </a>
                    <a class="nav-link"
                       href="https://github.com/JoyfulReaper/Random_Github"
                       target="_blank"
                       rel="noopener noreferrer">
                        Source
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container-xl">
            <span>
                Random GitHub &middot; Wandering through other people's questionable life choices since 2021.
            </span>

            @if (rateLimit is not null)
            {
                <span class="api-status">
                    GitHub API &middot;
                    @rateLimit.Remaining.ToString("N0") /
                    @rateLimit.Limit.ToString("N0") remaining
                </span>
            }

            <a asp-page="/Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>