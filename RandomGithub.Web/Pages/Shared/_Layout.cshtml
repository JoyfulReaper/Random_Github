@using RandomGithub.GitHub
@inject GitHubRateLimitStatus GitHubRateLimitStatus

@{
    var rateLimit = GitHubRateLimitStatus.Latest;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Random GitHub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RandomGithub.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand">
            <div class="container-xl">
                <a class="navbar-brand" asp-page="/Index">
                    Random GitHub
                </a>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-page="/Index">
                        Random
                    </a>
                    <a class="nav-link"
                       href="https://www.kgivler.com"
                       target="_blank"
                       rel="noopener noreferrer">
                        Website
                    </a>
                    <a class="nav-link"
                       href="https://github.com/JoyfulReaper/Random_Github"
                       target="_blank"
                       rel="noopener noreferrer">
                        Source
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container-xl">
            <div class="site-footer-row">
                <span>
                    Random GitHub &middot; Wandering through other people's questionable life choices since 2021.
                </span>
            </div>

            <div class="site-footer-row">
                <span>Also available on:</span>

                <a href="https://randomgit.kgivler.com/"
                   rel="noopener noreferrer">
                    Clearnet
                </a>

                <span>&middot;</span>

                <a href="http://git.ygg.kgivler.com/"
                   rel="noopener noreferrer">
                    Yggdrasil
                </a>

                <span>&middot;</span>

                <a href="https://randomgit.dn42/"
                   rel="noopener noreferrer">
                    DN42
                </a>

                <span class="site-footer-divider">|</span>

                <a href="https://github.com/JoyfulReaper/Random_Github"
                   target="_blank"
                   rel="noopener noreferrer">
                    Project / Source
                </a>
            </div>

            <div class="site-footer-note">
                The optional "Use your own GitHub token" feature is unavailable on
                the plain-HTTP Yggdrasil endpoint because its session cookie is Secure.
            </div>

            <div class="site-footer-note">
                Repository images and other remote assets may load directly from GitHub
                or other clearnet URLs and may not work on an isolated Yggdrasil or DN42 connection.
            </div>

            <div class="site-footer-row">
                <span>Proudly hosted with</span>

                <a href="https://greencloudvps.com/billing/aff.php?aff=10295"
                   target="_blank"
                   rel="sponsored noopener noreferrer">
                    GreenCloud VPS
                </a>
            </div>

            <div class="site-footer-note">
                Affiliate link &mdash; I may earn a commission if you sign up through it.
            </div>

            <div class="site-footer-row">
                @if (rateLimit is not null)
                {
                    <span class="api-status">
                        Shared GitHub API &middot;
                        @rateLimit.Remaining.ToString("N0") /
                        @rateLimit.Limit.ToString("N0") remaining
                    </span>

                    <span>&middot;</span>
                }

                <a asp-page="/Privacy">
                    Privacy
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>